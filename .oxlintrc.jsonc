{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Максимально строгий профиль для AI-разработки: correctness+suspicious+pedantic = error.
  // Каждый выключенный правило имеет комментарий-причину (домен: геометрия/пиксели).
  // plugins: vitest снят — его стайл-правила ломали семантику тестов (toBeTruthy → toBe(true)).
  "plugins": ["unicorn", "typescript", "react", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],

    // --- размер кода: гейт для всего нового кода (легаси заперто в overrides) ---
    "eslint/max-lines": ["error", { "max": 400, "skipComments": true, "skipBlankLines": true }],
    "eslint/max-lines-per-function": ["error", { "max": 150, "skipComments": true, "skipBlankLines": true }],
    "eslint/complexity": ["error", { "max": 20 }],
    "eslint/max-params": ["error", { "max": 5 }],
    "eslint/max-statements": ["error", { "max": 60 }],
    "eslint/max-depth": ["error", { "max": 4 }],

    // --- домен: пиксельная геометрия ---
    "eslint/no-magic-numbers": "off",
    "eslint/id-length": "off", // x/y/a/b в математике ядра
    "eslint/no-plusplus": "off",
    "oxc/no-optional-chaining": "off", // идиоматичный TS
    "typescript/no-non-null-assertion": "off", // точные инварианты горячих путей

    // --- стиль, конфликтующий с кодовой базой / oxfmt ---
    "eslint/one-var": "off",
    "eslint/curly": "off",
    "eslint/capitalized-comments": "off",
    "eslint/sort-keys": "off",
    "eslint/no-ternary": "off",
    "eslint/no-nested-ternary": "off", // тернарные цепочки в цветовых рампах — читаемы
    "unicorn/no-nested-ternary": "off",
    "eslint/func-style": "off",
    "eslint/no-continue": "off",
    "eslint/prefer-destructuring": "off",
    "eslint/sort-imports": "off", // порядок импортов закреплён за oxfmt (sortImports)
    "import/group-exports": "off", // именованные экспорты — наш стиль
    "import/exports-last": "off",
    "import/no-named-export": "off",
    "import/no-relative-parent-imports": "off", // границы проверяет dependency-cruiser
    "import/first": "off",
    "import/max-dependencies": "off",
    "oxc/no-rest-spread-properties": "off",
    "typescript/method-signature-style": "off",
    "eslint/eqeqeq": ["error", "smart"], // == null (null-или-undefined) легален
    "eslint/no-eq-null": "off",

    // --- React ---
    "react/react-in-jsx-scope": "off", // jsx: react-jsx
    "react/jsx-max-depth": "off",
    "react/only-export-components": "off", // ui/index экспортирует хуки+компоненты
    "jsx-a11y/no-autofocus": "off", // фокус в модалках диалогов — намеренно

    // --- размер: легаси заперто ratchet'ом, растить нельзя ---
    "vitest/prefer-expect-assertions": "off",
    "vitest/require-test-timeout": "off",
    "vitest/prefer-to-be-truthy": "off",
    "vitest/prefer-strict-equal": "off",
    "vitest/prefer-to-be-falsy": "off",
    "vitest/valid-title": "off",
    "vitest/valid-describe-callback": "off",
    "vitest/no-hooks": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/max-expects": "off",
    "vitest/no-importing-vitest-globals": "off", // явные импорты ок; глобсы типизированы
    "vitest/prefer-to-have-length": "off",
    "vitest/prefer-describe-function-title": "off",
    "vitest/consistent-test-it": "off",

    // --- опасные автофиксы (ломали типы) — см. AGENTS.md ---
    "unicorn/prefer-at": "off", // .at(-1) возвращает T|undefined
    "unicorn/prefer-spread": "off", // спред Uint16Array даёт number[]
    "unicorn/no-useless-undefined": "off", // выедал undefined-аргументы
    "unicorn/prefer-dom-node-dataset": "off", // dataset недоступен на Element
    "unicorn/no-array-reverse": "off", // reverse() на копии — безопасно, lib ES2022

    // --- точечный триаж стилей ---
    "eslint/no-use-before-define": "off", // хойстинг функций — норма для модулей ядра
    "import/consistent-type-specifier-style": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-bitwise": "off", // битовые операции — ядро дизеринга и масок
    "eslint/require-unicode-regexp": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/prefer-structured-clone": "off",
    "unicorn/prefer-single-call": "off",
    "unicorn/no-immediate-mutation": "off",
    "unicorn/no-array-fill-with-reference-type": "off",
    "unicorn/prefer-math-trunc": "off",
    "unicorn/prefer-math-min-max": "off",
    "unicorn/prefer-native-coercion-functions": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/prefer-code-point": "off", // charCodeAt над суррогатами — осознанно
    "unicorn/new-for-builtins": "off", // конфликт с no-new-array
    "unicorn/no-new-array": "off", // Array.from в тестах уже применён
    "eslint/init-declarations": "off",
    "eslint/prefer-named-capture-group": "off",
    "unicorn/max-nested-calls": "off",
    "react/no-multi-comp": "off",
    "eslint/no-duplicate-imports": "off",
    "react/forbid-component-props": "off",
    "react/refs": "off",
    "unicorn/no-array-for-each": "off",
    "jsx-a11y/click-events-have-key-events": "off", // canvas: pointer-события + глобальная клавиатура
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "eslint/require-await": "off", // async-сигнатура — часть API
    "eslint/no-underscore-dangle": "off", // __store — соглашение devtools-хука
    "import/no-unassigned-import": "off", // side-effect импорт index.css
    "unicorn/prefer-top-level-await": "off",
    "react/purity": "off", // Date.now в render диалогов — осознанный паттерн
    "oxc/branches-sharing-code": "off", // рефакторинг горячей геометрии не оправдан
    "eslint/no-undefined": "off",
    "eslint/no-void": "off",

    // --- возвращаемые типы и прочее, покрытое выводом типов / tsc ---
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "unicorn/prefer-global-this": "off",
    "oxc/no-async-await": "off", // async/await — идиоматика проекта
    "react/jsx-no-literals": "off",
    "import/prefer-default-export": "off", // только именованные экспорты
    "react/jsx-filename-extension": "off",
    "typescript/prefer-for-of": "off", // в ядре индекс needed: циклы по Uint16Array с записью
    "unicorn/number-literal-case": "off",
    "eslint/no-implicit-coercion": "off",
    "typescript/explicit-member-accessibility": "off",
    "unicorn/numeric-separators-style": "off",
    "eslint/no-multi-assign": "off",
    "eslint/no-param-reassign": "off", // мутация вершин геометрии — идиоматика
    "unicorn/no-array-reduce": "off",
    "eslint/no-empty-function": "off",
    "typescript/consistent-type-imports": "off", // verbatimModuleSyntax уже требует type-импортов
    "unicorn/no-await-expression-member": "off",
    "eslint/default-case": "off", // switch по union-типам: tsc проверяет полноту

    // --- advisory: читаем при каждом ревью, исправляем или обосновываем ---
    "eslint/no-shadow": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "react/memo-dependencies": "warn",
    "react/set-state-in-effect": "warn",

    "unicorn/no-null": "off" // null валиден в этом коде (DOM, сравнения)
  },
  "ignorePatterns": ["dist/", "node_modules/", "coverage/"],
  // Пины fill-style-controls/import-dialog/import-image подняты на +4..6 под интеграцию
  // глиф-пикеров и методов (2026-09). Расти дальше нельзя.
  // RATCHET: легаси-файлы заперты на текущем размере (см. AGENTS.md) — расти нельзя,
  // только уменьшать. Цель — довести каждый файл до глобальных порогов.
  // Пины fill-style-controls/import-dialog/import-image подняты на +4..6 под интеграцию
