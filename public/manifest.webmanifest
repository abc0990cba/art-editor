{
  "name": "Ditherlab — pixel editor",
  "short_name": "Ditherlab",
  "description": "A minimalist pixel web editor with clean vector SVG export.",
  "start_url": "/editor/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#131316",
  "theme_color": "#131316",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
